# ==============================
# General Application Settings
# ==============================

# Where downloads are saved (relative from home or absolute path).
# Example: Downloads
ANIWORLD_DOWNLOAD_PATH=Downloads

# Folder used for app data/cache/config (relative paths are resolved from home).
# Example: .aniworld
ANIWORLD_INSTALL_FOLDER=.aniworld

# Debug logging
# 0 = off, 1 = on
ANIWORLD_DEBUG_MODE=0

# Separate downloads into language subfolders (e.g. german-dub/, english-sub/)
# 0 = off, 1 = on
ANIWORLD_LANG_SEPARATION=0

# Language of the web interface.
# Options: en | de
ANIWORLD_UI_LANGUAGE=en

# Wrap movies in their own folder (e.g. "Movie (2024)/Movie (2024).mkv").
# 0 = save the file directly into the download path, 1 = use a folder
ANIWORLD_MOVIE_FOLDER=1


# ==============================
# Anime & Language Preferences
# ==============================

# Disable English Sub downloads entirely
# 0 = off, 1 = on
ANIWORLD_DISABLE_ENGLISH_SUB=0

# Preferred audio/sub language preset.
# Options: German Dub | English Sub | German Sub | English Dub
ANIWORLD_LANGUAGE="German Dub"

# Output file naming template.
# Common placeholders: {title} {year} {imdbid} {season} {episode} {language}
# Example: groups by show + year, then season, then uses SxxExx naming
# (e.g. `Highschool DxD (2012) [imdbid-tt1759761]/Season 1/Highschool DxD S01E01.mkv`).
ANIWORLD_NAMING_TEMPLATE="{title} ({year}) [imdbid-{imdbid}]/Season {season}/{title} S{season}E{episode}.mkv"


# ==============================
# Provider & Streaming Options
# ==============================

# Streaming provider to use.
# Look at SUPPORTED_PROVIDERS in config.py for options.
ANIWORLD_PROVIDER=VOE

# Provider fallback order used after the selected provider fails.
# The selected provider is always tried first, then the remaining providers follow this order.
ANIWORLD_PROVIDER_FALLBACK_ORDER=VOE,Vidmoly,Vidoza,Doodstream

# Pick a random anime instead of the one you pass in.
# 0 = off, 1 = on
ANIWORLD_RANDOM_ANIME=0

# Prefer serienstream.to for interactive search() by default.
# 1 = serienstream.to, 0 = aniworld.to
ANIWORLD_USE_STO_SEARCH=0

# Enable AniSkip (auto skip intro/outro) if skip times are available.
# 0 = off, 1 = on
ANIWORLD_ANISKIP=0

# Enable hanime.tv support (adult content).
# 0 = off, 1 = on
ANIWORLD_ENABLE_HTV=0

# Enable the BurningSeries tab.
# Disabled by default: BurningSeries is behind a geo-block and additionally
# protected by Google reCAPTCHA, which we currently have no way to bypass.
# Turn this on only if you can reach it yourself (e.g. correct region / VPN).
# 0 = off, 1 = on
ANIWORLD_ENABLE_BURNINGSERIES=0

# Enable the Kinox tab.
# Disabled by default: Kinox demands a captcha for every download, which we
# currently have no way to bypass automatically.
# 0 = off, 1 = on
ANIWORLD_ENABLE_KINOX=0


# ==============================
# Captcha Solver Settings
# ==============================
# Fine-tuning for the Cloudflare Turnstile captcha solver (playwright/captcha.py).
# All of these are optional — the defaults already work for most setups.

# Never auto-click a captcha widget - only your own click (CLI window / Web UI) counts.
# 0 = off (auto-solve), 1 = on (manual only)
ANIWORLD_CAPTCHA_MANUAL=0

# Show the captcha browser window instead of pushing it off-screen.
# 0 = off (hidden), 1 = on (visible)
ANIWORLD_CAPTCHA_VISIBLE=0

# Solve timeout in seconds. Leave empty to use the built-in default
# (300s for the standalone solver, 90s for the serienstream.to modal flow).
ANIWORLD_CAPTCHA_TIMEOUT=

# Disable the network ad-blocker used during captcha solving.
# Try turning this on if a captcha page won't load.
# 0 = adblock on, 1 = adblock off
ANIWORLD_NO_ADBLOCK=0

# Disable auto-closing of pop-up ad tabs opened during the serienstream.to modal flow.
# 0 = guard on, 1 = guard off
ANIWORLD_CAPTCHA_NO_ADTAB_GUARD=0

# Disable removal of invisible full-page ad-overlay links that can hijack clicks.
# 0 = removal on, 1 = removal off
ANIWORLD_CAPTCHA_NO_OVERLAY_REMOVAL=0

# Disable syncing the HTTP session's User-Agent to the solving browser's real UA.
# 0 = sync on, 1 = sync off
ANIWORLD_CAPTCHA_NO_UA_SYNC=0

# Spoof the WebGL renderer string (Intel/Mesa) to mask SwiftShader on GPU-less
# servers/Docker. Usually not needed - leave off unless you're troubleshooting.
# 0 = off, 1 = on
ANIWORLD_SPOOF_WEBGL=0

# Force a persistent Chromium profile (keeps a warm cf_clearance cookie across
# solves) even outside Docker, where it is off by default.
# 0 = off, 1 = on
ANIWORLD_PERSISTENT_PROFILE=0

# Force a fresh (non-persistent) browser profile every solve, even inside
# Docker, where persistence is normally on by default.
# 0 = off, 1 = on
ANIWORLD_NO_PERSISTENT_PROFILE=0

# Custom directory for the persistent Chromium profile.
# Leave empty to use the default: ~/.aniworld/browser-profile
ANIWORLD_BROWSER_PROFILE=

# Manually flag the process as running in Docker (normally auto-detected via
# /.dockerenv). Affects the persistent-profile default and a few launch args.
# 0 = off, 1 = on
ANIWORLD_DOCKER=0


# ==============================
# Player Integration
# ==============================

# Which player Syncplay should use.
# 0 = mpv (cross-platform)
# 1 = IINA (macOS only; requires IINA installed)
ANIWORLD_USE_IINA=1


# ==============================
# Syncplay Settings (auto-generated if left empty)
# ==============================

# Syncplay server host:port
# Default: syncplay.pl:8998
# Other ports: syncplay.pl:8995 / :8996 / :8997 / :8999
ANIWORLD_SYNCPLAY_HOST=

# Room to join.
# If ANIWORLD_SYNCPLAY_ROOM is empty, the app generates it from the episode name:
# - If ANIWORLD_SYNCPLAY_PASSWORD is NOT set:
#     AniWorld-Highschool_DxD_S01E01
# - If ANIWORLD_SYNCPLAY_PASSWORD IS set (example: "beans"), the room becomes a SHA256 hash:
#     plain: AniWorld-Highschool_DxD_S01E01-beans
#     room:  AniWorld-53de358cf5b5fe716f78747bad1c874ed23147509bbaf540d02aac31f4f35656
#
# Tip: setting ANIWORLD_SYNCPLAY_PASSWORD changes the generated room name, so only people with the same
# password end up in the same room (unless you manually set ANIWORLD_SYNCPLAY_ROOM).
ANIWORLD_SYNCPLAY_ROOM=

# Your name shown in Syncplay.
# If empty, it will use your system username.
# Example: phoenixthrush
ANIWORLD_SYNCPLAY_USERNAME=

# Optional. Used only when ANIWORLD_SYNCPLAY_ROOM is empty (see above).
# Setting this WILL change the generated room name.
ANIWORLD_SYNCPLAY_PASSWORD=


# ==============================
# Web UI Authentication
# ==============================

# Set both to auto-create an admin on first run with -wA (skips setup page)
ANIWORLD_WEB_ADMIN_USER=
ANIWORLD_WEB_ADMIN_PASS=


# Public base URL when behind a reverse proxy (e.g. https://example.com).
# Leave empty when not using a reverse proxy.
ANIWORLD_WEB_BASE_URL=


# ==============================
# OIDC Single Sign-On (optional)
# ==============================

# Required when using -wS or -wFS flags.
ANIWORLD_OIDC_ISSUER_URL=
ANIWORLD_OIDC_CLIENT_ID=
ANIWORLD_OIDC_CLIENT_SECRET=
ANIWORLD_OIDC_DISPLAY_NAME=SSO

# When using -wFS (force SSO), this SSO username is auto-promoted to admin.
# Using ANIWORLD_OIDC_ADMIN_SUBJECT is preferred !!!
ANIWORLD_OIDC_ADMIN_USER=

# SSO subject (sub claim) for the admin user - more secure than username matching.
# If set, this takes precedence over ANIWORLD_OIDC_ADMIN_USER for admin promotion.
# Tip: the subject is logged on every SSO login - check the server logs to find it.
# In Keycloak: Admin Console -> Users -> click user -> the "ID" field is the sub claim.
ANIWORLD_OIDC_ADMIN_SUBJECT=


# ==============================
# Auto-Sync Settings
# ==============================

# How often to check for new episodes.
# Options: 0 (disabled) | 1min | 30min | 1h | 2h | 4h | 8h | 12h | 16h | 24h
ANIWORLD_SYNC_SCHEDULE=0

# Default language for new sync jobs.
# Options: German Dub | English Sub | German Sub
ANIWORLD_SYNC_LANGUAGE=German Dub

# Default provider for new sync jobs.
# Options: VOE | Vidmoly | Vidoza
ANIWORLD_SYNC_PROVIDER=VOE


# ==============================
# FFmpeg & Encoding Settings
# ==============================

# Video codec behavior.
# copy = no re-encode (fastest, keeps original)
# h264 / h265 / av1 = re-encode using FFmpeg (slower, smaller files depending on settings)
ANIWORLD_VIDEO_CODEC=copy


# ==============================
# Discord Request Bot (optional)
# ==============================

# Let users request movies and series from Discord.
# 0 = off, 1 = on
ANIWORLD_DISCORD_BOT_ENABLED=0

# Bot token from https://discord.com/developers/applications
ANIWORLD_DISCORD_TOKEN=

# Your Discord user ID. Requests are sent here for approval.
ANIWORLD_DISCORD_OWNER_ID=

# standard  = every request needs your approval via DM
# advanced  = requests are queued immediately
ANIWORLD_DISCORD_MODE=standard

# Only members with this role may request. Leave empty to allow everyone.
ANIWORLD_DISCORD_REQUEST_ROLE_ID=

# Register the slash commands in this server only (instant).
# Leave empty to register globally (can take up to an hour to appear).
ANIWORLD_DISCORD_GUILD_ID=

# Bot language: command names, descriptions and messages.
# Options: en | de
ANIWORLD_DISCORD_LANGUAGE=en

# Optional channel ID. When a requested download finishes, a "now available"
# message is posted here (the requester is always DM'd regardless).
ANIWORLD_DISCORD_ANNOUNCE_CHANNEL_ID=
