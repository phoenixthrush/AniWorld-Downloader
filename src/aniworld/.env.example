# AniWorld Downloader startup settings
# On first start, the app creates ~/.aniworld/.env by default. Edit it and restart.
# Process environment values take precedence. For toggles, 1 is on and 0 is off.
# See https://www.phoenixthrush.com/AniWorld-Downloader-Docs/configuration for the full reference.

# --- Storage ---
# Relative paths are resolved from your home directory. The Docker image uses
# /app/Downloads. Keep Docker path overrides aligned with the volume mounts.
ANIWORLD_DOWNLOAD_PATH=Downloads
# App data directory for the database, .env, and custom themes.
ANIWORLD_INSTALL_FOLDER=.aniworld

# --- Web UI ---
# Interface language: en or de.
ANIWORLD_UI_LANGUAGE=en
# Show the Library tab for browsing and deleting downloads.
ANIWORLD_ENABLE_LIBRARY=1
# Offer all language presets in the download dialog regardless of the first episode.
ANIWORLD_SHOW_ALL_LANGUAGES=0

# --- Web UI sites ---
# Toggles follow the tab order. Disabling a site hides its tab and rows.
# Keep at least one site enabled.
ANIWORLD_ENABLE_ANIWORLD=1
ANIWORLD_ENABLE_STO=1
# BurningSeries and Kinox may require manual verification.
ANIWORLD_ENABLE_BURNINGSERIES=0
ANIWORLD_ENABLE_MEGAKINO=1
ANIWORLD_ENABLE_MOFLIX=1
ANIWORLD_ENABLE_KINOX=0
ANIWORLD_ENABLE_FILMPALAST=1
ANIWORLD_ENABLE_FILMO=1
# Adult sites are off by default.
ANIWORLD_ENABLE_HTV=0
ANIWORLD_ENABLE_HENTAITV=0
ANIWORLD_ENABLE_HENTAIHAVEN=0
ANIWORLD_ENABLE_MANGAFIRE=1

# --- Site-specific options ---
# Leave empty to use kinox.to.
ANIWORLD_KINOX_DOMAIN=
# jpg downloads chapter images. cbz and epub prefer volumes with chapter fallback.
# EPUB requires the optional aniworld[epub] extra.
ANIWORLD_MANGAFIRE_FORMAT=jpg

# --- Download preferences ---
# German Dub, English Sub, German Sub, or English Dub.
ANIWORLD_LANGUAGE="German Dub"
# Hide English Sub choices and reject them in Web UI and API submissions.
ANIWORLD_DISABLE_ENGLISH_SUB=0
# Preferred stream host, tried first when available.
ANIWORLD_PROVIDER=VOE
# Preferred fallback hosts, in order. Other available hosts can still be tried.
ANIWORLD_PROVIDER_FALLBACK_ORDER=VOE,Vidmoly,Vidoza,Doodstream
# Parallel segment downloads for direct HLS, from 1 to 32.
ANIWORLD_HLS_CONCURRENCY=8

# --- Output files ---
# Relative output path. The extension selects the output container.
# Other placeholders include {resolution} and {language}.
ANIWORLD_NAMING_TEMPLATE="{title} ({year}) [imdbid-{imdbid}]/Season {season}/{title} S{season}E{episode}.mkv"
# Use each season's episode index for AniWorld and SerienStream filenames.
ANIWORLD_SEASON_EPISODE_NUMBERS=0
# Put Web UI queue downloads in language subfolders such as german-dub/.
ANIWORLD_LANG_SEPARATION=0
# Give movie downloads their own title folders on backends that support it.
ANIWORLD_MOVIE_FOLDER=1
# copy keeps source streams. Software encoders: h264, h265, av1.
# Hardware encoders require compatible devices, drivers, and FFmpeg support.
# NVIDIA: h264_nvenc, hevc_nvenc. AMD: h264_amf, hevc_amf, av1_amf.
# Intel: h264_qsv, hevc_qsv, av1_qsv.
ANIWORLD_VIDEO_CODEC=copy

# --- Auto-Sync for series already on disk ---
# Automatically queue missing AniWorld episodes on a schedule.
ANIWORLD_ENABLE_AUTOSYNC=0
# Queue only the newly announced episodes and leave earlier gaps alone.
ANIWORLD_AUTOSYNC_NEW_ONLY=0
# interval runs after the configured delay. cron runs at fixed local times.
ANIWORLD_AUTOSYNC_MODE=interval
# Examples: 6h, 90m, 1h30m. Bare numbers are hours.
ANIWORLD_AUTOSYNC_INTERVAL=24h
# Five-field cron or plain language, such as "every day at 3am".
ANIWORLD_AUTOSYNC_CRON="0 3 * * *"

# --- Reverse proxy ---
# Public origin for redirects, such as https://aniworld.example.com.
ANIWORLD_WEB_BASE_URL=
# IP of the directly connected proxy for forwarded client IP and scheme headers.
# Use * only when the app can be reached exclusively through the proxy.
ANIWORLD_WEB_TRUSTED_PROXY=

# --- CA bundle overrides ---
# Leave unset to use certifi. The first configured path in this order supplies
# the app's HTTP bundle and the default for any unset CA variables.
# REQUESTS_CA_BUNDLE=
# CURL_CA_BUNDLE=
# SSL_CERT_FILE=

# --- Local authentication ---
# Enable username/password login. Set both admin fields to create the first admin.
ANIWORLD_WEB_AUTH=0
ANIWORLD_WEB_ADMIN_USER=
ANIWORLD_WEB_ADMIN_PASS=

# --- OIDC single sign-on ---
# Enable the SSO option alongside local authentication, or require SSO for login.
ANIWORLD_WEB_SSO=0
ANIWORLD_WEB_FORCE_SSO=0
# Set the issuer URL, client ID, and client secret before enabling SSO.
ANIWORLD_OIDC_ISSUER_URL=
ANIWORLD_OIDC_CLIENT_ID=
ANIWORLD_OIDC_CLIENT_SECRET=
# Label shown on the login button.
ANIWORLD_OIDC_DISPLAY_NAME=SSO
# Match the identity provider's subject to grant admin access.
# The username field is an alternative. Either configured field can match.
ANIWORLD_OIDC_ADMIN_SUBJECT=
ANIWORLD_OIDC_ADMIN_USER=

# --- Discord request bot ---
# Let users request downloads from Discord. Changes saved in the Web UI persist.
ANIWORLD_DISCORD_BOT_ENABLED=0
ANIWORLD_DISCORD_TOKEN=
# Discord user ID of the bot owner.
ANIWORLD_DISCORD_OWNER_ID=
# standard asks the owner to approve requests. advanced queues them immediately.
ANIWORLD_DISCORD_MODE=standard
# Restrict requests to a role. Leave empty to allow everyone.
ANIWORLD_DISCORD_REQUEST_ROLE_ID=
# Register commands in a single server. Leave empty for global registration.
ANIWORLD_DISCORD_GUILD_ID=
# Bot language: en or de.
ANIWORLD_DISCORD_LANGUAGE=en
# Optional channel for completed-download announcements.
ANIWORLD_DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Webhook ---
# Send a request when the Web UI queue drains after at least one success.
# Leave the URL empty to disable it. Changes saved in the Web UI persist.
ANIWORLD_WEBHOOK_URL=
# POST, GET, PUT, or PATCH.
ANIWORLD_WEBHOOK_METHOD=POST
# Use Name: value pairs separated by |.
ANIWORLD_WEBHOOK_HEADERS=
# Optional request body. JSON objects and arrays get a JSON content type by default.
ANIWORLD_WEBHOOK_BODY=

# --- Browser and CAPTCHA ---
# Load uBlock Origin Lite in the bundled Patchright Chromium.
ANIWORLD_UBLOCK=0
# auto follows the flow's window setting. 1 shows the window, 0 keeps it off-screen.
ANIWORLD_CAPTCHA_VISIBLE=auto
# Positive seconds. Leave empty to keep the flow's built-in timeout.
ANIWORLD_CAPTCHA_TIMEOUT=
# Solve widgets yourself. Completed forms still submit automatically.
ANIWORLD_CAPTCHA_MANUAL=0
# Log browser console warnings, errors, and failed requests.
ANIWORLD_CAPTCHA_DEBUG_LOG=0

# --- Runtime and diagnostics ---
# Set to 1 to disable automatic downloads and installs of missing dependencies.
ANIWORLD_NO_AUTO_INSTALL=0
# Enable detailed logging.
ANIWORLD_DEBUG_MODE=0

# --- CLI menu and search ---
# Hide Watch and Syncplay in the terminal menu. The Docker image sets this to 1.
ANIWORLD_MENU_DOWNLOAD_ONLY=0
# Skip the terminal menu and supply URLs or an episode file.
ANIWORLD_NO_MENU=0
# Pick a random anime from the selected search site.
ANIWORLD_RANDOM_ANIME=0
# Use SerienStream instead of AniWorld for interactive search.
ANIWORLD_USE_STO_SEARCH=0

# --- CLI playback ---
# Skip intros and outros when timestamps are available.
ANIWORLD_ANISKIP=0
# Continue watching or syncing through the rest of the season.
ANIWORLD_KEEP_WATCHING=0
# On macOS, use IINA for Watch. Set to 0 for mpv. Syncplay always uses mpv.
ANIWORLD_USE_IINA=1

# --- Syncplay ---
# Leave empty to connect to syncplay.pl:8998.
ANIWORLD_SYNCPLAY_HOST=
# Leave empty to derive a room name from the episode filename.
ANIWORLD_SYNCPLAY_ROOM=
# Leave empty to use your system username.
ANIWORLD_SYNCPLAY_USERNAME=
# Optional value used to derive the room name when no room is specified.
ANIWORLD_SYNCPLAY_PASSWORD=
