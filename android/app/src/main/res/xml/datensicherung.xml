<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts sichern und nichts aufs neue Handy übertragen: Cookies der Seiten, Warteschlange
     und Einstellungen bleiben auf diesem Gerät. allowBackup="false" allein deckt die
     Übertragung von Gerät zu Gerät ab Android 12 nicht ab. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
